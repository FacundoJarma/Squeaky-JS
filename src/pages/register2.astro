---
import BackgroundImage from "../components/BackgroundImage.astro";
import RegisterFormTwo from "../sections/RegisterFormTwo.astro";
import LayoutLoginRegister from "../layout/LayoutLoginRegister.astro";
import MascotaInteractiva from "../components/MascotaInteractiva.astro";
---

<LayoutLoginRegister title="Squeaky JS | Crear Cuenta segundo Paso">
  <main class="relative h-screen w-screen flex justify-center items-end">
    <BackgroundImage />
    <RegisterFormTwo />
    <MascotaInteractiva
      classList="h-64 w-64 absolute bottom-6 right-12"
      consejo="Ya hiciste un paso, no te rindas ahora!"
    />
  </main>
</LayoutLoginRegister>
