---
import EditorExercicesLayout from "../../../layout/EditorExercicesLayout.astro";
import CodeEditorForEditorExercices from "../../../sections/CodeEditorForEditorExercices.astro";
import MascotaInteractiva from "../../../components/MascotaInteractiva.astro";
---

<EditorExercicesLayout title="Ejercicio con Editor de codigo - 1 | Squeaky JS">
  <div class="w-full">
    <CodeEditorForEditorExercices

      context=`En la parte de la derecha podras ver un saludo de bienvenida de un sitio web. 
      Tu tarea sera cambiar el titulo de la pagina (el que ahora dice 'Hola usuario, buen dia!') 
      por: 'Hola estudiante, esto es SqueakyJS.' (recuerda, es importante que sea exactamente igual).`
      pageUrl="/emulatedPages/2.html"
    />

    <iframe class="w-screen h-[90.5vh] bg-white" id="editorPage"></iframe>
    <MascotaInteractiva 
      classList="h-64 w-64 absolute bottom-6 left-[30em]"
      consejo="No creo que pueda ayudarte..."
      validTries={100}
    />
  </div>
</EditorExercicesLayout>
