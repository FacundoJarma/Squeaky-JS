---
import MascotaInteractiva from "../../../components/MascotaInteractiva.astro";
import MonacoEditor from "../../../components/MonacoEditor.astro";
import EditorExercicesLayout from "../../../layout/EditorExercicesLayout.astro";
import CodeEditorForEditorExercices from "../../../sections/CodeEditorForEditorExercices.astro";
---

<EditorExercicesLayout title="Ejercicio con Editor de codigo - 1 | Squeaky JS">
  <div class="w-full">
    <CodeEditorForEditorExercices

      context=`Una empresa muy desagradable que tiene un profundo odio
       por los arboles usa una tecnica muy rara para saber si tienen que cortar un arbol. 
       Elijen un numero aletorio y si este mismo es mayor a 5, entonces cortan el arbol. 
       Si es menor a 5, lo dejan como esta.
        Tu mision es que dada una variable llamada 'number', verifiques si su valor es mayor a '5' y 
      llames a la funcion 'cortarArbol()', en el caso de que sea menor llama a la funcion: 'dejarArbol()'`
      pageUrl="/emulatedPages/1.html"
    />

    <iframe class="w-screen h-[90.5vh] bg-white" id="editorPage"></iframe>
    <MascotaInteractiva 
      classList="h-64 w-64 absolute bottom-6 left-[30em]"
      consejo="No creo que pueda ayudarte..."
      validTries={100}
    />
  </div>
</EditorExercicesLayout>
