<script>
    import { postData } from "../lib/socket.js";
    function getUser(){
        let user = localStorage.getItem("user");
        user = JSON.parse(user);
        if(!user) window.location.href = "/login";
        postData("racha", {
            username: user.username
        }, () => {
            console.log("Tu sesion se guardad correctamente.");
        })
        return user
    }
    getUser();
</script>