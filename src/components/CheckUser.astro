---
// No pongas lógica en el frontmatter: todo irá en el <script client:load>
---
<script  >
  import { supabase } from '../lib/supabase/client';
  import { actualizarRachaUsuario } from '../lib/supabaseAuth';

  console.log('CheckUser');
  // Función auto‑invocada tras cargar el cliente
  (async () => {
    const { data: sessionData } = await supabase.auth.getSession();
    const user = sessionData?.session?.user;
    if (!user) {
      // Si no está logueado, redirige
      window.location.href = '/login';
      return;
    }
    // Si está, actualiza la racha
    try {
      await actualizarRachaUsuario(user.id);
    } catch (e) {
      console.error('Error al actualizar racha:', e);
    }
  })();
</script>

<slot />
