---

---

<div class="w-4/5 h-16 relative mx-auto">
  <span
    class="h-16 w-16 rounded-full bg-[#2E2E2E] text-white border border-[#A4A4A4] z-10 text-2xl grid place-items-center"
    id="rachaSpan"
  >
    --
  </span>
  <div
    class="h-10 w-4/5 bg-[#4C4C4C] border border-[#A4A4A4] rounded-full absolute top-1/2 left-10 z-[-1] -translate-y-1/2 px-6 flex items-center"
  >
    <div class="bg-[#23262F] h-4 w-full rounded-full -ml-2">
      <div id="line" class="h-full rounded-full"></div>
    </div>
  </div>
</div>

<style>
  #line {
    width: 0%;
    background: linear-gradient(
      90deg,
      #ffb800 0%,
      #ffdc82 20%,
      #ffb800 40%,
      #ffdc82 60%,
      #ffb800 80%,
      #ffdc82 100%
    );
    transition: 0.3s all;
  }
</style>

<script>
  import { getStreak } from "../lib/supabaseAuth";
  const user = JSON.parse(localStorage.getItem("user"));

  getStreak().then((racha) => {
    const r = racha.streak
    document.getElementById("line").style.width = Number(r) + "%";
    const rachaSpan = document.getElementById("rachaSpan");
    if (rachaSpan) {
      rachaSpan.innerHTML = r;
    }
  });
</script>
