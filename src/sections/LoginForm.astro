---
import { Icon } from "astro-icon/components";
---

<form
  id="loginForm"
  class="z-10 w-[35em] bg-black/70 h-[90vh] rounded-t-2xl px-16 py-16"
>
  <div class="flex flex-col gap-7 mb-7">
    <h1 class="text-4xl text-white font-bold ml-4 font-[inter] mb-6">
      Inicia sesión
    </h1>
    <div class="flex flex-col gap-5">
      <input
        type="email"
        id="email"
        name="email"
        placeholder="Email"
        class="text-xl w-full h-16 rounded-lg border border-[#858585] px-4 bg-[#181818]/80 text-[#A6A6A6] font-[inter]"
      />
      <div class="password-container">
        <input
          type="password"
          id="password"
          name="password"
          placeholder="Contraseña"
          class="w-full h-16 rounded-lg border border-[#858585] px-4 bg-[#181818]/80 text-[#A6A6A6] font-[inter] text-xl"
        />
        <div id="togglePassword" class="eye-icon">
          <Icon name="eyeOff" height={24} width={24} />
        </div>
      </div>

      <input
        type="submit"
        value="Siguiente"
        class="text-2xl h-12 w-full bg-[#FFB800] text-black font-bold rounded-lg hover:cursor-pointer hover:scale-[102%] duration-100 font-[inter]"
      />
    </div>
  </div>
  <div class="flex flex-col gap-0.5">
    <span class="block text-center text-gray-300 mt-6 text-xl font-[inter]"
      >¿No tienes cuenta de Squeaky? <a
        href="/register1"
        class="text-[#FFDA7A] duration-300">Crear cuenta</a
      ></span
    >
  </div>
</form>

<style>
  .eye-icon {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    cursor: pointer;
    font-size: 18px;
  }
  .password-container {
    position: relative;
  }
</style>

<script>
  import Toastify from "toastify-js";

  document.addEventListener("DOMContentLoaded", () => {
    const $loginForm = document.getElementById("loginForm");
    const $email = document.getElementById("email");
    const $password = document.getElementById("password");
    const togglePassword = document.getElementById("togglePassword");

    if (!($loginForm && $email && $password)) return;

    $loginForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!$email.value || !$password.value) {
        Toastify({
          text: "No puedes enviar datos vacíos!",
          duration: 1000,
          style: { background: "red" },
        }).showToast();
        return;
      }

      try {
        const body = new URLSearchParams({
          email: $email.value,
          password: $password.value,
        }).toString(); // 👈 clave

        console.log(body);

        const res = await fetch("/api/auth/signin", {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
          },
          body, // ahora es string
        });

        if (!res.ok) {
          const text = await res.text();
          throw new Error(text || "Error al iniciar sesión");
        }

        Toastify({
          text: "Has iniciado sesión correctamente!",
          duration: 1000,
        }).showToast();

        console.log(res.json());
         
        const { auth, profile } = await res.json();

        // Guardar en localStorage solo en cliente
        localStorage.setItem("user", JSON.stringify({ auth, profile }));

        // Ahora podés redirigir o actualizar UI
        window.location.href = "/";

        
      } catch (error) {
        console.error(error);
        Toastify({
          text: error.message || "Error al iniciar sesión.",
          duration: 2000,
          style: { background: "red" },
        }).showToast();
      }
    });

    togglePassword.addEventListener("click", () => {
      if ($password.value === "") return;
      const type =
        $password.getAttribute("type") === "password" ? "text" : "password";
      $password.setAttribute("type", type);

      togglePassword.innerHTML =
        type !== "password"
          ? "<svg>…icon-eye…</svg>"
          : "<svg>…icon-eye-off…</svg>";
    });
  });
</script>
