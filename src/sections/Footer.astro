    <div class="flex justify-between  py-14 border-b border-white"> 
        <div class="flex gap-1 items-center">
            <div class="h-8 rounded-full aspect-square bg-[#FFB800]"></div>
            <img src="/SQKY LOGO.png" class="h-10"/>
        </div>
        <span class="text-white text-lg">© 2024 ⎯ 2026 SqueakyJS Inc.</span>
        <ul class="flex gap-3">
            <li> <Icon name="youTube" height={32} width={32} /> </li>
            <li><Icon name="instagram" height={32} width={32} /></li>
            <li><Icon name="x" height={32} width={32} /></li>
        </ul>
    </div>
    <div class="mt-6 flex justify-between">
        <div class="flex gap-48 items-center">
            <ul class="flex flex-col gap-4">
                <li> <a href="/" class="underline">Inicio</a> </li>
                <li> <a href="/lecciones" class="underline">Lecciones</a> </li>
                <li> <a href="/ejercicios" class="underline">Ejercicios</a> </li>
