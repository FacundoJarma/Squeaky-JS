---
import LectionCard from "../components/LectionCard.astro";
import { getCollection } from "astro:content";

let lecciones = await getCollection("lecciones");

lecciones = lecciones.sort((a, b) => a.data.index - b.data.index);

---

<main class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-5 my-24 gap-4 lg:px-0 px-6 auto-rows-[217px]">

  {
    lecciones.map(({ data: leccion, slug }, index) => (
      <LectionCard
        index={index + 1} // Esta 0-indexed 
        classList={leccion.classList}
        difficult={leccion.difficult}
        name={leccion.title}
        url={slug}
      />
      
    ))
  }


</main>


<script>
  import ScrollReveal from "scrollreveal";
import { getFavorites } from "../lib/lessons";

  getFavorites().then(favs => {

    favs.forEach((favorito) => {
      const $addFav = document.getElementById(
        `lection-${favorito.lesson_slug}`
      ) as HTMLButtonElement;
      console.log(`lection-${favorito.lesson_slug}`, $addFav);
      if(!$addFav) return;
      $addFav.classList.add("isFav");
    });
  });

  var slideUp = {

    distance: '120%',
    origin: 'bottom',
    opacity: 0.5,
    duration: 500,
    scale: 0.85 
};
  ScrollReveal().reveal(".lection", slideUp);
</script>
