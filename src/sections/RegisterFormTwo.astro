---
import { Icon } from "astro-icon/components";
---

<form
  id="registerForm"
  class="z-10 w-[35em] bg-black/70 h-[90vh] rounded-t-2xl px-16 py-16"
>
  <div class="flex flex-col gap-5 mb-7">
    <h1 class="text-4xl text-white font-bold ml-4 font-[inter] mb-6">
      Crear cuenta
    </h1>
    <input
      type="text"
      id="username"
      name="username"
      placeholder="Nombre de usuario"
      class="mb-4 text-xl w-full h-16 rounded-lg border border-[#858585] px-4 bg-[#181818]/80 text-[#A6A6A6] font-[inter]"
    />
    <input
      type="date"
      id="date"
      name="date"
      placeholder="Fecha"
      class="mb-4 text-xl w-full h-16 rounded-lg border border-[#858585] px-4 bg-[#181818]/80 text-[#A6A6A6] font-[inter]"
    />
    <input
      type="email"
      id="email"
      name="email"
      placeholder="Email"
      class="mb-4 text-xl w-full h-16 rounded-lg border border-[#858585] px-4 bg-[#181818]/80 text-[#A6A6A6] font-[inter]"
    />
    <div class="password-container">
      <input
        type="password"
        id="password"
        name="password"
        placeholder="Contraseña"
        class="mb-4 text-xl w-full h-16 rounded-lg border border-[#858585] px-4 bg-[#181818]/80 text-[#A6A6A6] font-[inter]"
      />
      <div id="togglePassword" class="eye-icon">
        <Icon name="eyeOff" height={24} width={24} />
      </div>
    </div>
    <div class="password-container">
      <input
        type="password"
        id="passwordAgain"
        name="passwordAgain"
        placeholder="Repita su contraseña"
        class="text-xl w-full h-16 rounded-lg border border-[#858585] px-4 bg-[#181818]/80 text-[#A6A6A6] font-[inter]"
      />
    </div>

    <input
      type="submit"
      value="Terminar"
      class="text-2xl h-12 mt-4 w-full bg-[#FFB800] text-black font-bold rounded-lg hover:cursor-pointer hover:scale-[102%] duration-100 font-[inter]"
    />
  </div>

  <span class="block text-center text-gray-300 mt-6 text-xl font-[inter]">
    ¿Ya tienes cuenta de Squeaky? 
    <a href="/login" class="text-[#FFDA7A] duration-300">Inicia sesión</a>
  </span>
</form>

<style>
  .eye-icon {
    position: absolute;
    top: 50%;
    right: 10px;
    transform: translateY(-50%);
    cursor: pointer;
    font-size: 18px;
    margin-bottom: 2em;
  }
  .password-container {
    position: relative;
  }
</style>

<script>
  import Toastify from "toastify-js";

  document.addEventListener("DOMContentLoaded", () => {
    const $registerForm = document.getElementById("registerForm");
    const $username = document.getElementById("username");
    const $date = document.getElementById("date");
    const $email = document.getElementById("email");
    const $password = document.getElementById("password");
    const $passwordAgain = document.getElementById("passwordAgain");
    const togglePassword = document.getElementById("togglePassword");

    if (!($registerForm && $username && $date && $email && $password && $passwordAgain))
      return;

    $registerForm.addEventListener("submit", async (event) => {
      event.preventDefault();

      if ($password.value !== $passwordAgain.value) {
        Toastify({
          text: "Las contraseñas no coinciden!",
          duration: 1500,
          style: { background: "red" },
        }).showToast();
        return;
      }

      if (
        !$username.value ||
        !$date.value ||
        !$email.value ||
        !$password.value
      ) {
        Toastify({
          text: "No puedes enviar datos vacíos!",
          duration: 1500,
          style: { background: "red" },
        }).showToast();
        return;
      }

      try {
        const body = new URLSearchParams({
          username: $username.value,
          date: $date.value,
          email: $email.value,
          password: $password.value,
        }).toString();

        const res = await fetch("/api/register", {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
          },
          body,
        });

        if (!res.ok) {
          const text = await res.text();
          throw new Error(text || "Error al crear usuario");
        }

        Toastify({
          text: "Usuario creado exitosamente!",
          duration: 1500,
        }).showToast();

        window.location.href = "/login";
      } catch (error) {
        console.error(error);
        Toastify({
          text: error.message || "Error inesperado",
          duration: 2000,
          style: { background: "red" },
        }).showToast();
      }
    });

    togglePassword.addEventListener("click", () => {
      if ($password.value === "") return;
      const type =
        $password.getAttribute("type") === "password" ? "text" : "password";
      $password.setAttribute("type", type);

      togglePassword.innerHTML =
        type !== "password"
          ? "<svg>…icon-eye…</svg>"
          : "<svg>…icon-eye-off…</svg>";
    });
  });
</script>
