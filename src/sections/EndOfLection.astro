---
const { exercises, lectionSlug } = Astro.props;
---

<button
  data-lection={lectionSlug}
  data-url={exercises
    ? "/ejercicios/" + exercises[0].id
    : "/lecciones"}
  id="goToExercise"
  class="fixed bottom-6 right-8 w-36 h-14 bg-[#33353B]/80 p-2 rounded-lg text-xl font-bold duration-200"
>
  Continuar
</button>

<style>
  .active {
    background: #99a125 !important;
  }
</style>

<script>
  import { completeLesson } from "../lib/lessons";
  import Toastify from "toastify-js";

  document.addEventListener("DOMContentLoaded", () => {
    const $btn = document.getElementById("goToExercise") as HTMLButtonElement;
    let activated = false;

    function onScroll() {
      if (
        !activated &&
        window.innerHeight + window.scrollY >= document.body.offsetHeight - 10
      ) {
        activated = true;
        $btn.classList.add("active");

        $btn.addEventListener("click", async () => {
          const lectionSlug = $btn.dataset.lection as string;
          try {
            await completeLesson(lectionSlug);
            Toastify({
              text: "Lección completada",
              duration: 1000,
              style: {
                background: "green",
              },
            }).showToast();
          } catch (e) {
            console.error(e);
          }

          // Redireccionar si todo va bien
          window.location.href = $btn.dataset.url;
        });

        // Eliminar el scroll listener si ya no lo necesitás
        window.removeEventListener("scroll", onScroll);
      }
    }

    window.addEventListener("scroll", onScroll);
  });
</script>
